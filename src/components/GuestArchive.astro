---
import type { CollectionEntry } from "astro:content";
import { titleSplitConfig } from "../config";
import { splitTitle } from "../utils/title-utils";
import { getGuestPostUrlBySlug } from "../utils/url-utils";

interface Props {
    posts: CollectionEntry<"guests">[];
}

const { posts } = Astro.props;

interface YearGroup {
    year: number;
    posts: CollectionEntry<"guests">[];
}

const byYear = new Map<number, CollectionEntry<"guests">[]>();
for (const post of posts) {
    const year = new Date(post.data.published).getFullYear();
    const arr = byYear.get(year);
    if (arr) arr.push(post);
    else byYear.set(year, [post]);
}

const groups: YearGroup[] = Array.from(byYear.entries())
    .map(([year, ps]) => ({ year, posts: ps }))
    .sort((a, b) => b.year - a.year);

function formatDate(date: Date) {
    const month = (date.getMonth() + 1).toString().padStart(2, "0");
    const day = date.getDate().toString().padStart(2, "0");
    return `${month}-${day}`;
}

function formatTags(tags: string[]) {
    return tags.map((t) => `#${t}`).join(" ");
}
---

<div class="card-base px-8 py-6">
    {groups.map((group) => (
        <div>
            <div class="flex flex-row w-full items-center h-[3.75rem]">
                <div class="w-[15%] md:w-[10%] transition text-2xl font-bold text-right text-75">
                    {group.year}
                </div>
                <div class="w-[15%] md:w-[10%]">
                    <div class="h-3 w-3 bg-none rounded-full outline outline-[var(--primary)] mx-auto -outline-offset-[2px] z-50 outline-3"></div>
                </div>
                <div class="w-[70%] md:w-[80%] transition text-left text-50">
                    {group.posts.length} 篇文章
                </div>
            </div>

            {group.posts.map((post) => {
                const titleParts =
                    titleSplitConfig.enable && splitTitle(post.data.title)
                        ? splitTitle(post.data.title)
                        : null;
                return (
                    <a
                        href={getGuestPostUrlBySlug(post.slug)}
                        aria-label={post.data.title}
                        class="group btn-plain !block h-10 w-full rounded-lg hover:text-[initial]"
                    >
                        <div class="flex flex-row justify-start items-center h-full">
                            <div class="w-[15%] md:w-[10%] transition text-sm text-right text-50">
                                {formatDate(post.data.published)}
                            </div>
                            <div class="w-[15%] md:w-[10%] relative dash-line h-full flex items-center">
                                <div class="transition-all mx-auto w-1 h-1 rounded group-hover:h-5 bg-[oklch(0.5_0.05_250)] group-hover:bg-[var(--primary)] outline outline-4 z-50 outline-[var(--card-bg)] group-hover:outline-[var(--btn-plain-bg-hover)] group-active:outline-[var(--btn-plain-bg-active)]"></div>
                            </div>
                            <div class="w-[70%] md:max-w-[65%] md:w-[65%] text-left font-bold group-hover:translate-x-1 transition-all group-hover:text-[var(--primary)] text-75 pr-8 whitespace-nowrap overflow-ellipsis overflow-hidden">
                                {titleParts ? (
                                    <>
                                        <span class="font-bold">{titleParts.prefix}</span>
                                        <span class="font-bold">{titleParts.separator}</span>
                                        <span class="font-normal" style={`opacity: ${titleSplitConfig.opacity}`}>{titleParts.suffix}</span>
                                    </>
                                ) : (
                                    post.data.title
                                )}
                            </div>
                            <div class="hidden md:block md:w-[15%] text-left text-sm transition whitespace-nowrap overflow-ellipsis overflow-hidden text-30">
                                {formatTags(post.data.tags)}
                            </div>
                        </div>
                    </a>
                );
            })}
        </div>
    ))}
</div>
