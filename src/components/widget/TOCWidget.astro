---
import type { MarkdownHeading } from "astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
	headings: MarkdownHeading[];
	/** 与系列卡同屏时挤压高度，给系列卡腾另一半 */
	compact?: boolean;
}

const { headings = [], compact = false } = Astro.props;
const className = Astro.props.class;
const style = Astro.props.style;

const removeTailingHash = (text: string) => {
	let lastIndexOfHash = text.lastIndexOf("#");
	if (lastIndexOfHash !== text.length - 1) {
		return text;
	}
	return text.substring(0, lastIndexOfHash);
};

let minDepth = 10;
for (const heading of headings) {
	minDepth = Math.min(minDepth, heading.depth);
}

const maxLevel = 3; // 限制显示层级：相对 minDepth 的 0/1/2

// 每个 heading 标注 level (0/1/2) + 一级序号
type Annotated = MarkdownHeading & { level: number; h1Index?: number };
const annotated: Annotated[] = [];
let h1Counter = 0;
for (const h of headings) {
	const level = h.depth - minDepth;
	if (level >= maxLevel) continue;
	const item: Annotated = { ...h, level };
	if (level === 0) {
		h1Counter += 1;
		item.h1Index = h1Counter;
	}
	annotated.push(item);
}

// 把「二级 + 其后的三级」打包成 h2-group；其余作为 flat 节点。
type Group =
	| { kind: "flat"; item: Annotated }
	| { kind: "h2-group"; item: Annotated; children: Annotated[] };

const groups: Group[] = [];
let openGroup: { kind: "h2-group"; item: Annotated; children: Annotated[] } | null = null;
for (const h of annotated) {
	if (h.level === 1) {
		openGroup = { kind: "h2-group", item: h, children: [] };
		groups.push(openGroup);
	} else if (h.level === 2 && openGroup) {
		openGroup.children.push(h);
	} else {
		groups.push({ kind: "flat", item: h });
		openGroup = null;
	}
}
---

<WidgetLayout name="经纬" id="toc-widget" class={className} style={style}>
    <div id="toc-widget-inner" class:list={["toc-widget-scrollable", { "toc-widget-compact": compact }]}>
        {annotated.length > 0 ? (
            <toc-widget class="group">
                {groups.map((g) => g.kind === "flat" ? (
                    <a href={`#${g.item.slug}`}
                       data-level={g.item.level}
                       class:list={[
                           "toc-entry px-2 flex items-center gap-2 relative transition w-full min-h-8 rounded-lg",
                           "hover:bg-[var(--toc-btn-hover)] active:bg-[var(--toc-btn-active)] py-2",
                           { "toc-entry-h3": g.item.level === 2 },
                       ]}
                    >
                        <div class:list={["transition w-4 h-4 shrink-0 rounded-md text-xs flex items-center justify-center font-bold",
                            {
                                "bg-[var(--toc-badge-bg)] text-[var(--btn-content)]": g.item.level === 0,
                                "ml-3": g.item.level === 1,
                                "ml-6": g.item.level === 2,
                            }
                        ]}>
                            {g.item.level === 0 && g.item.h1Index}
                            {g.item.level === 1 && <div class="transition w-1.5 h-1.5 rounded-sm bg-[var(--toc-badge-bg)]"></div>}
                            {g.item.level === 2 && <div class="transition w-1 h-1 rounded bg-black/5 dark:bg-white/10"></div>}
                        </div>
                        <div class:list={["transition text-sm truncate", {
                            "text-50": g.item.level === 0 || g.item.level === 1,
                            "text-30": g.item.level === 2,
                        }]}>{removeTailingHash(g.item.text)}</div>
                    </a>
                ) : (
                    <div class="toc-h2-group">
                        <a href={`#${g.item.slug}`}
                           data-level={g.item.level}
                           class:list={[
                               "toc-entry px-2 flex items-center gap-2 relative transition w-full min-h-8 rounded-lg",
                               "hover:bg-[var(--toc-btn-hover)] active:bg-[var(--toc-btn-active)] py-2",
                           ]}
                        >
                            <div class="transition w-4 h-4 shrink-0 rounded-md text-xs flex items-center justify-center font-bold ml-3">
                                <div class="transition w-1.5 h-1.5 rounded-sm bg-[var(--toc-badge-bg)]"></div>
                            </div>
                            <div class="transition text-sm truncate text-50">{removeTailingHash(g.item.text)}</div>
                        </a>
                        {g.children.map((h3) => (
                            <a href={`#${h3.slug}`}
                               data-level={h3.level}
                               class:list={[
                                   "toc-entry toc-entry-h3 px-2 flex items-center gap-2 relative transition w-full min-h-8 rounded-lg",
                                   "hover:bg-[var(--toc-btn-hover)] active:bg-[var(--toc-btn-active)] py-2",
                               ]}
                            >
                                <div class="transition w-4 h-4 shrink-0 rounded-md text-xs flex items-center justify-center font-bold ml-6">
                                    <div class="transition w-1 h-1 rounded bg-black/5 dark:bg-white/10"></div>
                                </div>
                                <div class="transition text-sm truncate text-30">{removeTailingHash(h3.text)}</div>
                            </a>
                        ))}
                    </div>
                ))}
                <div id="toc-active-indicator" style="opacity: 0" class:list={["-z-10 absolute bg-[var(--toc-btn-hover)] left-0 right-0 rounded-md transition-all " +
                    "group-hover:bg-transparent border-2 border-[var(--toc-btn-hover)] group-hover:border-[var(--toc-btn-active)] border-dashed"]}></div>
            </toc-widget>
        ) : (
            <div class="px-2 py-6 text-center text-black/30 dark:text-white/30 text-sm">
                本文暂无目录
            </div>
        )}
    </div>
</WidgetLayout>

<script>
class TOCWidget extends HTMLElement {
    tocEl: HTMLElement | null = null;
    visibleClass = "visible";
    observer: IntersectionObserver;
    anchorNavTarget: HTMLElement | null = null;
    headingIdxMap = new Map<string, number>();
    headings: HTMLElement[] = [];
    sections: HTMLElement[] = [];
    tocEntries: HTMLAnchorElement[] = [];
    active: boolean[] = [];
    activeIndicator: HTMLElement | null = null;
    h2Groups: HTMLElement[] = [];

    constructor() {
        super();
        this.observer = new IntersectionObserver(
            this.markVisibleSection, { threshold: 0 }
        );
    };

    markVisibleSection = (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry) => {
            // Support both: ID on the section itself (friends/about), or ID on first child (post pages)
            const id = entry.target.getAttribute("id") ?? entry.target.children[0]?.getAttribute("id");
            const idx = id ? this.headingIdxMap.get(id) : undefined;
            if (idx != undefined)
                this.active[idx] = entry.isIntersecting;

            if (entry.isIntersecting && this.anchorNavTarget == entry.target.firstChild)
                this.anchorNavTarget = null;
        });

        if (!this.active.includes(true))
            this.fallback();
        this.update();
    };

    toggleActiveHeading = () => {
        let i = this.active.length - 1;
        let min = this.active.length - 1, max = -1;
        while (i >= 0 && !this.active[i]) {
            this.tocEntries[i].classList.remove(this.visibleClass);
            i--;
        }
        while (i >= 0 && this.active[i]) {
            this.tocEntries[i].classList.add(this.visibleClass);
            min = Math.min(min, i);
            max = Math.max(max, i);
            i--;
        }
        while (i >= 0) {
            this.tocEntries[i].classList.remove(this.visibleClass);
            i--;
        }

        // 根据 visible 切换 h2 group 的 expanded 状态，必须在算 indicator 前完成
        // 否则 h3 entry 的 rect 会因 display:none 拿到 0
        this.updateGroupExpansion();

        if (min > max) {
            this.activeIndicator?.setAttribute("style", `opacity: 0`);
        } else {
            let parentOffset = this.tocEl?.getBoundingClientRect().top || 0;
            let scrollOffset = this.tocEl?.scrollTop || 0;
            let top = this.tocEntries[min].getBoundingClientRect().top - parentOffset + scrollOffset;
            let bottom = this.tocEntries[max].getBoundingClientRect().bottom - parentOffset + scrollOffset;
            this.activeIndicator?.setAttribute("style", `top: ${top}px; height: ${bottom - top}px`);
        }
    };

    updateGroupExpansion = () => {
        for (const group of this.h2Groups) {
            const hasVisible = !!group.querySelector(`a.${this.visibleClass}`);
            group.classList.toggle("expanded", hasVisible);
        }
    };

    scrollToActiveHeading = () => {
        if (this.anchorNavTarget || !this.tocEl) return;
        const activeHeading =
            document.querySelectorAll<HTMLDivElement>(`#toc-widget .${this.visibleClass}`);
        if (!activeHeading.length) return;

        const topmost = activeHeading[0];
        const bottommost = activeHeading[activeHeading.length - 1];
        const tocHeight = this.tocEl.clientHeight;

        let top;
        if (bottommost.getBoundingClientRect().bottom -
            topmost.getBoundingClientRect().top < 0.9 * tocHeight)
            top = topmost.offsetTop - 32;
        else
            top = bottommost.offsetTop - tocHeight * 0.8;

        this.tocEl.scrollTo({
            top,
            left: 0,
            behavior: "smooth",
        });
    };

    update = () => {
        requestAnimationFrame(() => {
            this.toggleActiveHeading();
            this.scrollToActiveHeading();
        });
    };

    fallback = () => {
        if (!this.sections.length) return;

        for (let i = 0; i < this.sections.length; i++) {
            let offsetTop = this.sections[i].getBoundingClientRect().top;
            let offsetBottom = this.sections[i].getBoundingClientRect().bottom;

            if (this.isInRange(offsetTop, 0, window.innerHeight)
                || this.isInRange(offsetBottom, 0, window.innerHeight)
                || (offsetTop < 0 && offsetBottom > window.innerHeight)) {
                this.markActiveHeading(i);
            }
            else if (offsetTop > window.innerHeight) break;
        }
    };

    markActiveHeading = (idx: number)=> {
        this.active[idx] = true;
    };

    handleAnchorClick = (event: Event) => {
        const anchor = event
            .composedPath()
            .find((element) => element instanceof HTMLAnchorElement);

        if (anchor) {
            const id = decodeURIComponent(anchor.hash?.substring(1));
            const idx = this.headingIdxMap.get(id);
            if (idx !== undefined) {
                this.anchorNavTarget = this.headings[idx];
            } else {
                this.anchorNavTarget = null;
            }
        }
    };

    isInRange(value: number, min: number, max: number) {
        return min < value && value < max;
    };

    connectedCallback() {
        // Post pages: #post-container children have onload-animation whose animationend
        // bubbles up to .prose — use that as the trigger so getBoundingClientRect is accurate.
        // Other pages (about, friends…): sections are static, double-RAF is sufficient.
        const postContainer = document.querySelector('#post-container');
        if (postContainer) {
            const prose = document.querySelector('.prose');
            if (prose) {
                prose.addEventListener('animationend', () => this.init(), { once: true });
                return;
            }
        }
        requestAnimationFrame(() => requestAnimationFrame(() => this.init()));
    };

    init() {
        this.tocEl = document.getElementById("toc-widget-inner");

        if (!this.tocEl) return;

        this.tocEl.addEventListener("click", this.handleAnchorClick, {
            capture: true,
        });

        this.activeIndicator = document.getElementById("toc-active-indicator");

        this.tocEntries = Array.from(
            document.querySelectorAll<HTMLAnchorElement>("#toc-widget a[href^='#']")
        );

        this.h2Groups = Array.from(
            document.querySelectorAll<HTMLElement>("#toc-widget .toc-h2-group")
        );

        if (this.tocEntries.length === 0) return;

        this.sections = new Array(this.tocEntries.length);
        this.headings = new Array(this.tocEntries.length);
        for (let i = 0; i < this.tocEntries.length; i++) {
            const id = decodeURIComponent(this.tocEntries[i].hash?.substring(1));
            const heading = document.getElementById(id);
            if (!(heading instanceof HTMLElement)) continue;
            // If the ID element is itself a container (section/div/article),
            // observe it directly; otherwise observe its parent (post-page pattern).
            const isContainer = ['SECTION', 'DIV', 'ARTICLE'].includes(heading.tagName);
            const section = isContainer ? heading : heading.parentElement;
            if (section instanceof HTMLElement) {
                this.headings[i] = heading;
                this.sections[i] = section;
                this.headingIdxMap.set(id, i);
            }

            // 清洗 TOC entry 文本：去掉 heading 上的脚注引用与 autolink 锚点
            // 用 DOM clone 而非正则，避免误伤合法的数字结尾标题（如 "2024 年回顾"）
            // 仅对真正的 heading 元素（h1-h6）处理；container（section/div/article）跳过，
            // 否则会把整个 section 的所有文字都拼进 textContent
            if (!isContainer) {
                const clone = heading.cloneNode(true) as HTMLElement;
                clone.querySelectorAll(
                    ".fn-tip-wrap, sup.footnote-ref, [data-footnote-ref], a.anchor, .anchor-icon"
                ).forEach((el) => el.remove());
                const cleanText = (clone.textContent ?? "").replace(/\s+/g, " ").trim();
                if (cleanText) {
                    const textDiv = this.tocEntries[i].querySelector<HTMLElement>(
                        ":scope > div:last-child"
                    );
                    if (textDiv) textDiv.textContent = cleanText;
                }
            }
        }
        this.active = new Array(this.tocEntries.length).fill(false);

        this.sections.forEach((section) =>
            this.observer.observe(section)
        );

        this.fallback();
        this.update();
    };

    disconnectedCallback() {
        this.sections.forEach((section) =>
            this.observer.unobserve(section)
        );
        this.observer.disconnect();
        this.tocEl?.removeEventListener("click", this.handleAnchorClick);
    };
}

if (!customElements.get("toc-widget")) {
    customElements.define("toc-widget", TOCWidget);
}
</script>

<style>
    /* TOC Widget styles */
    toc-widget {
        position: relative;
    }

    /* 可滚动的目录容器 */
    .toc-widget-scrollable {
        max-height: calc(100vh - 10rem);
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: none;
        -ms-overflow-style: none;
        position: relative;
    }
    /* 与系列卡同屏：占 2/3，给同辙留 1/3 */
    .toc-widget-compact {
        max-height: calc((100vh - 10rem) * 2 / 3);
    }

    /* Active indicator styles - 矩形样式 */
    #toc-active-indicator {
        position: absolute;
        left: 0;
        right: 0;
        transition: all 0.2s ease;
        pointer-events: none;
    }

    /* Hover effects - 与原来的TOC组件保持一致 */
    toc-widget a:hover {
        background-color: var(--toc-btn-hover);
    }

    toc-widget a:active {
        background-color: var(--toc-btn-active);
    }

    /* 三级标题默认折叠：只有所在 h2 group 处于 .expanded（含 active 项）时展开 */
    .toc-h2-group:not(.expanded) .toc-entry-h3 {
        display: none;
    }
</style>
