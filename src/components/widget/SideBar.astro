---
import type { MarkdownHeading } from "astro";
import type { SeriesPost } from "../../utils/series-utils";
import { url } from "../../utils/url-utils";
import Categories from "./Categories.astro";
import GalleryCategories from "./GalleryCategories.astro";
import Profile from "./Profile.astro";
import SeriesWidget from "./SeriesWidget.astro";
import Tag from "./Tags.astro";
import TOCWidget from "./TOCWidget.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	series?: {
		posts: SeriesPost[];
		currentSlug: string;
	};
}

const className = Astro.props.class;
const { headings = [], series } = Astro.props;
// 仅当系列至少包含 2 篇（包括当前文章自己）才展示
const showSeries = series && series.posts.length > 1;

// 检查页面类型
const isPostsRoute = Astro.url.pathname.startsWith(url("/posts/"));
const isGalleryRoute = Astro.url.pathname.startsWith(url("/gallery"));
const isAboutRoute =
	Astro.url.pathname === url("/about") || Astro.url.pathname === url("/about/");
const isFriendsRoute =
	Astro.url.pathname === url("/friends") ||
	Astro.url.pathname === url("/friends/");
const guestsPrefix = url("/guests/");
const isGuestsRoute = Astro.url.pathname.startsWith(guestsPrefix);
// /guests/<author>/<slug>/ —— 仅文章详情页（≥2 段）启用 TOC
const isGuestPostRoute =
	isGuestsRoute &&
	Astro.url.pathname.slice(guestsPrefix.length).split("/").filter(Boolean)
		.length >= 2;
const isTocPage =
	isPostsRoute || isAboutRoute || isFriendsRoute || isGuestPostRoute;
const isNormalPage = !isTocPage && !isGalleryRoute;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <!-- 非正文页：显示简介卡片 -->
    {!isPostsRoute && !isGuestPostRoute &&
    <div class="flex flex-col w-full gap-4 mb-4 onload-animation" data-widget-key="profile" style="animation-delay: calc(var(--content-delay))">
        <Profile></Profile>
    </div>
    }

    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky top-4">
        <!-- 普通页面：显示文章分类和标签卡片 -->
        {isNormalPage &&
        <>
            <div data-widget-key="categories" class="contents">
                <Categories class="onload-animation" style="animation-delay: calc(var(--content-delay))"></Categories>
            </div>
            <div data-widget-key="tags" class="contents">
                <Tag class="onload-animation" style="animation-delay: calc(var(--content-delay))"></Tag>
            </div>
        </>
        }

        <!-- 摄影页面：显示图片类别卡片 -->
        {isGalleryRoute &&
            <div data-widget-key="gallery-categories" class="contents">
                <GalleryCategories class="onload-animation" style="animation-delay: calc(var(--content-delay))"></GalleryCategories>
            </div>
        }

        <!-- 正文页/about页：先 TOC（经纬），后系列卡（舆图）；同屏时 TOC 自动压成一半高 -->
        {isTocPage && (
            <div data-widget-key="toc" class="contents">
                <TOCWidget headings={headings} compact={showSeries} class="onload-animation" style="animation-delay: calc(var(--content-delay))"></TOCWidget>
            </div>
        )}
        {isTocPage && showSeries && series && (
            <div data-widget-key="series" class="contents">
                <SeriesWidget
                    posts={series.posts}
                    currentSlug={series.currentSlug}
                    class="onload-animation"
                    style="animation-delay: calc(var(--content-delay))"
                />
            </div>
        )}
    </div>
</div>
