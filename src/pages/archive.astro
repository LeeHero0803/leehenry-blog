---
import ArchivePanel from "@components/ArchivePanel.svelte";
import Heatmap from "@components/widget/Heatmap.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { titleSplitConfig } from "../config";
import postWordsRaw from "../data/post-words.json";
import { getSortedPostsList } from "../utils/content-utils";
import { splitTitle } from "../utils/title-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

const sortedPostsList = await getSortedPostsList();
const postWords = postWordsRaw as { date: string; words: number }[];

// noscript 兜底：按年份分组（与 ArchivePanel.svelte 一致）
const grouped: Record<number, typeof sortedPostsList> = {};
for (const post of sortedPostsList) {
	const d = new Date(post.data.published);
	const y = d.getFullYear();
	(grouped[y] ??= []).push(post);
}
const groupsByYear = Object.keys(grouped)
	.map((y) => ({ year: Number(y), posts: grouped[Number(y)] }))
	.sort((a, b) => b.year - a.year);

const formatMD = (d: Date | string) => {
	const dt = d instanceof Date ? d : new Date(d);
	return `${String(dt.getMonth() + 1).padStart(2, "0")}-${String(dt.getDate()).padStart(2, "0")}`;
};
const formatTags = (tags: string[]) => tags.map((t) => `#${t}`).join(" ");
---

<MainGridLayout title="🗂️ 旧简">
  <div class="archive-noscript-wrap">
    <div class="card-base px-8 py-6 archive-noscript">
      {groupsByYear.map((group) => (
        <div>
          <div class="flex flex-row w-full items-center h-[3.75rem]">
            <div class="w-[15%] md:w-[10%] transition text-2xl font-bold text-right text-75">
              {group.year}
            </div>
            <div class="w-[15%] md:w-[10%]">
              <div class="h-3 w-3 bg-none rounded-full outline outline-[var(--primary)] mx-auto -outline-offset-[2px] z-50 outline-3"></div>
            </div>
            <div class="w-[70%] md:w-[80%] transition text-left text-50">
              {group.posts.length} 篇文章
            </div>
          </div>

          {group.posts.map((post) => {
            const parts = titleSplitConfig.enable ? splitTitle(post.data.title) : null;
            return (
              <a
                href={getPostUrlBySlug(post.slug)}
                aria-label={post.data.title}
                class="group btn-plain !block h-10 w-full rounded-lg hover:text-[initial]"
              >
                <div class="flex flex-row justify-start items-center h-full">
                  <div class="w-[15%] md:w-[10%] transition text-sm text-right text-50">
                    {formatMD(post.data.published)}
                  </div>
                  <div class="w-[15%] md:w-[10%] relative dash-line h-full flex items-center">
                    <div class="transition-all mx-auto w-1 h-1 rounded group-hover:h-5 bg-[oklch(0.5_0.05_250)] group-hover:bg-[var(--primary)] outline outline-4 z-50 outline-[var(--card-bg)] group-hover:outline-[var(--btn-plain-bg-hover)] group-active:outline-[var(--btn-plain-bg-active)]"></div>
                  </div>
                  <div class="w-[70%] md:max-w-[65%] md:w-[65%] text-left font-bold group-hover:translate-x-1 transition-all group-hover:text-[var(--primary)] text-75 pr-8 whitespace-nowrap overflow-ellipsis overflow-hidden">
                    {parts ? (
                      <>
                        <span class="font-bold">{parts.prefix}</span>
                        <span class="font-bold">{parts.separator}</span>
                        <span class="font-normal" style={`opacity: ${titleSplitConfig.opacity}`}>{parts.suffix}</span>
                      </>
                    ) : (
                      post.data.title
                    )}
                  </div>
                  <div class="hidden md:block md:w-[15%] text-left text-sm transition whitespace-nowrap overflow-ellipsis overflow-hidden text-30">
                    {formatTags(post.data.tags)}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ))}
    </div>
    <style is:global>
      .archive-noscript-wrap { display: none; }
      html.no-js .archive-noscript-wrap { display: block; }
      html.no-js .archive-heatmap { display: none !important; }
    </style>
  </div>

  <section class="archive-heatmap">
    <Heatmap entries={postWords} client:only="svelte" cell={9} gap={2} />
  </section>

  <ArchivePanel sortedPosts={sortedPostsList} client:only="svelte" />
</MainGridLayout>

<style>
  .archive-heatmap {
    margin-bottom: 20px;
    display: none;
  }
  @media (min-width: 768px) {
    .archive-heatmap {
      display: block;
    }
  }
</style>
